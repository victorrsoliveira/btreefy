<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="main">
    <Fallback>
      <Sequence>
        <ScriptCondition code="Bt_Emerg?"/>
        <Script code="Motor(0)"/>
        <Script code="Emergencia()"/>
      </Sequence>
      <Sequence>
        <Fallback>
          <ScriptCondition code="Emergencia?"/>
          <ScriptCondition code="Abrir?"/>
          <ScriptCondition code="Abrindo?"/>
        </Fallback>
        <Script code="Motor(-1)"/>
      </Sequence>
      <Sequence>
        <Fallback>
          <ScriptCondition code="Aberta?"/>
          <ScriptCondition code="Fechada?"/>
        </Fallback>
        <Script code="Motor(0)"/>
      </Sequence>
      <Sequence>
        <Fallback>
          <ScriptCondition code="Fechar?"/>
          <ScriptCondition code="Fechando?"/>
        </Fallback>
        <Script code="Motor(1)"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel/>

</root>
