<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="CondicoesAbrir?">
    <Fallback>
      <ScriptCondition code="Emergencia?"/>
      <ScriptCondition code="Abrindo?"/>
      <Sequence>
        <ScriptCondition code="Fechada?"/>
        <ScriptCondition code="Abrir?"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="CondicoesFechar?">
    <Fallback>
      <ScriptCondition code="Fechar?"/>
      <ScriptCondition code="Fechando?"/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="CondicoesParar?">
    <Fallback>
      <ScriptCondition code="Aberta?"/>
      <ScriptCondition code="Fechada?"/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="main">
    <Fallback>
      <Sequence>
        <ScriptCondition code="Bt_Emerg?"/>
        <Script code="Motor(0)"/>
        <Script code="Emergencia()"/>
      </Sequence>
      <Sequence>
        <SubTree ID="CondicoesAbrir?"/>
        <Script code="Motor(-1)"/>
      </Sequence>
      <Sequence>
        <SubTree ID="CondicoesFechar?"/>
        <Script code="Motor(1)"/>
      </Sequence>
      <Sequence>
        <SubTree ID="CondicoesParar?"/>
        <Script code="Motor(0)"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="main_new">
    <Fallback>
      <Sequence>
        <ScriptCondition name="IsEmergBtnPressed"
                         code="is_emerg_btn_pressed_cond"/>
        <Script name="StopMotor"
                code="stop_door_action"/>
        <Script name="Emergency"
                code="emergency_action"/>
        <Script name="OpenDoor"
                code="open_door_action"/>
      </Sequence>
      <Sequence>
        <ScriptCondition name="IsMotorOn"
                         code="is_motor_on_cond"/>
        <Fallback>
          <ScriptCondition name="IsDoorOpen"
                           code="is_open_cond"/>
          <ScriptCondition name="IsDoorClosed"
                           code="is_closed_cond"/>
        </Fallback>
        <Script name="StopMotor"
                code="stop_door_action"/>
      </Sequence>
      <Sequence>
        <ScriptCondition name="IsOpenRequest"
                         code="open_door_request_cond"/>
        <ScriptCondition name="IsDoorClosed"
                         code="is_closed_cond"/>
        <Script name="OpenDoor"
                code="open_door_action"/>
      </Sequence>
      <Sequence>
        <ScriptCondition name="IsCloseRequest"
                         code="close_door_request_cond"/>
        <ScriptCondition name="IsDoorOpen"
                         code="is_open_cond"/>
        <Script name="CloseDoor"
                code="close_door_action"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel/>

</root>
