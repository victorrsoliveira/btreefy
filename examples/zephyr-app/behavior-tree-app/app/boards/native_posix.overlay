/ {
        aliases {
                led0 = &led0;
                sw0 = &button0;
        };

        leds {
                compatible = "gpio-leds";
                led0: led_0 {
                        gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
                        label = "Green LED";
                };
        };

        buttons {
                compatible = "gpio-keys";
                button0: button_0 {
                        gpios = <&gpio0 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
                        label = "User Button";
                };
        };
};

&gpio0 {
        status = "okay";
        ngpios = <32>;
};
